#!/bin/sh
### BEGIN INIT INFO
# Provides:          {{ app_name }}
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: {{ app_name }} Spring Boot service
### END INIT INFO

NAME={{ app_name }}
JAR={{ app_dir }}/{{ app_name }}.jar
RUN_USER={{ app_user }}
PIDFILE=/var/run/$NAME.pid
LOG={{ app_dir }}/$NAME.log
export APP_PORT={{ app_port }}
export APP_MESSAGE="{{ app_message }}"

is_running() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null
}

case "$1" in
  start)
    if is_running; then echo "$NAME already running"; exit 0; fi
    start-stop-daemon --start --quiet --background --make-pidfile --pidfile "$PIDFILE" \
      --chuid "$RUN_USER" --startas /bin/sh -- -c "exec java -jar $JAR >> $LOG 2>&1"
    echo "$NAME started"
    ;;
  stop)
    start-stop-daemon --stop --quiet --pidfile "$PIDFILE" --retry 10 || true
    rm -f "$PIDFILE"
    echo "$NAME stopped"
    ;;
  restart)
    $0 stop
    $0 start
    ;;
  status)
    if is_running; then echo "$NAME is running"; exit 0; else echo "$NAME is not running"; exit 3; fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"; exit 1
    ;;
esac
exit 0
